 <Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>1.0.0</Version>
		<Description>Example mod for Mira API</Description>
		<Authors>Angxl, XtraCube</Authors>
        <Nullable>disable</Nullable>
        <WarningsAsErrors>$(WarningsAsErrors);CS8632</WarningsAsErrors>

        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DisableUnmanagedBindingResolution>true</DisableUnmanagedBindingResolution>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MiraAPI\MiraAPI.csproj" />
	</ItemGroup>

	 <ItemGroup>
		 <EmbeddedResource Include="Resources\**\*.*" />
	 </ItemGroup>

	<Import Project="..\AmongUs.props" />
</Project>
